# Environment Configuration Template
PROJECT_NAME="AI Financial Risk Manager for UPI-like Digital Payments"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Security & JWT
SECRET_KEY=replace-with-a-very-strong-secret-key-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for local development, PostgreSQL for Docker)
DATABASE_URL=sqlite:///./financial_risk.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_risk

# Fund Manager Cooling Rules
COOLING_PERIOD_MINUTES=30
RELEASE_RISK_THRESHOLD=40.0
REFUND_RISK_THRESHOLD=75.0
PERSONAL_RISK_HIGH_THRESHOLD=70.0
PAYEE_RISK_HIGH_THRESHOLD=65.0
OVERALL_RISK_HOLD_THRESHOLD=70.0
